{
  "name": "mygo-api",
  "private": true,
  "type": "module",
  "scripts": {
    "dev": "mygo dev",
    "build": "mygo build",
    "generate": "mygo generate",
    "dev:web": "vite",
    "build:web": "tsc --noEmit && vite build",
    "typecheck": "tsc --noEmit",
    "lint:ui": "node scripts/check-ui-tokens.mjs",
    "e2e": "go test -tags e2e ./e2e/ -count=1",
    "e2e:verbose": "go test -tags e2e ./e2e/ -count=1 -v"
  },
  "dependencies": {
    "@mygo-plugins/fetch": "^0.7.4",
    "@mygo-plugins/sqlite": "^0.7.4",
    "@mygo-plugins/websocket": "^0.7.4",
    "mygo-runtime": "^0.7.4"
  },
  "devDependencies": {
    "mygo-cli": "^0.7.4",
    "typescript": "^7",
    "vite": "^8"
  }
}
